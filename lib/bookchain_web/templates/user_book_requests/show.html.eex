<h1>Show User book requests</h1>

<ul>

  <li>
    <strong>User:</strong>
    <%= @user_book_requests.user %>
  </li>

  <li>
    <strong>Book:</strong>
    <%= @user_book_requests.book %>
  </li>

  <li>
    <strong>Status:</strong>
    <%= @user_book_requests.status %>
  </li>

</ul>

<span><%= link "Edit", to: Routes.user_book_requests_path(@conn, :edit, @user_book_requests) %></span>
<span><%= link "Back", to: Routes.user_book_requests_path(@conn, :index) %></span>
