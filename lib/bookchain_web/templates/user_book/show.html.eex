<h1>Show User book</h1>

<ul>

  <li>
    <strong>User:</strong>
    <%= @user_book.user %>
  </li>

  <li>
    <strong>Book:</strong>
    <%= @user_book.book %>
  </li>

</ul>

<span><%= link "Edit", to: Routes.user_book_path(@conn, :edit, @user_book) %></span>
<span><%= link "Back", to: Routes.user_book_path(@conn, :index) %></span>
