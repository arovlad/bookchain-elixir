<h1>Listing Users books</h1>

<table>
  <thead>
    <tr>
      <th>User</th>
      <th>Book</th>

      <th></th>
    </tr>
  </thead>
  <tbody>
<%= for user_book <- @users_books do %>
    <tr>
      <td><%= user_book.user %></td>
      <td><%= user_book.book %></td>

      <td>
        <span><%= link "Show", to: Routes.user_book_path(@conn, :show, user_book) %></span>
        <span><%= link "Edit", to: Routes.user_book_path(@conn, :edit, user_book) %></span>
        <span><%= link "Delete", to: Routes.user_book_path(@conn, :delete, user_book), method: :delete, data: [confirm: "Are you sure?"] %></span>
      </td>
    </tr>
<% end %>
  </tbody>
</table>

<span><%= link "New User book", to: Routes.user_book_path(@conn, :new) %></span>
