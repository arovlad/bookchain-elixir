<h1>Show User role</h1>

<ul>

  <li>
    <strong>User:</strong>
    <%= @user_role.user %>
  </li>

  <li>
    <strong>Role:</strong>
    <%= @user_role.role %>
  </li>

</ul>

<span><%= link "Edit", to: Routes.user_role_path(@conn, :edit, @user_role) %></span>
<span><%= link "Back", to: Routes.user_role_path(@conn, :index) %></span>
