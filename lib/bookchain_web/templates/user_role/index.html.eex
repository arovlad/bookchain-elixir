<h1>Listing Users roles</h1>

<table>
  <thead>
    <tr>
      <th>User</th>
      <th>Role</th>

      <th></th>
    </tr>
  </thead>
  <tbody>
<%= for user_role <- @users_roles do %>
    <tr>
      <td><%= user_role.user %></td>
      <td><%= user_role.role %></td>

      <td>
        <span><%= link "Show", to: Routes.user_role_path(@conn, :show, user_role) %></span>
        <span><%= link "Edit", to: Routes.user_role_path(@conn, :edit, user_role) %></span>
        <span><%= link "Delete", to: Routes.user_role_path(@conn, :delete, user_role), method: :delete, data: [confirm: "Are you sure?"] %></span>
      </td>
    </tr>
<% end %>
  </tbody>
</table>

<span><%= link "New User role", to: Routes.user_role_path(@conn, :new) %></span>
